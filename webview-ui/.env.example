# Embers REST origin only (no trailing path). Required for agent CRUD.
VITE_EMBERS_API_BASE=http://localhost:8000

# Embers task WebSocket. Origin or full URL; /ws is added if missing.
# If unset, the REST origin is converted (http→ws, https→wss).
VITE_EMBERS_WEBSOCKET_BASE=ws://localhost:8000

# Optional static token sent as the Authorization header.
# VITE_EMBERS_API_TOKEN=
